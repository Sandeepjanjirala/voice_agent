# syntax=docker/dockerfile:1

# Django, Gunicorn and Celery only. LiveKit's audio/ML stack belongs in ../Dockerfile.
# Build from the repository root; no host Python is needed on the VPS.
ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim-trixie AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /bin/uv
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --group backend --no-install-project

COPY manage.py ./
COPY config ./config
COPY apps ./apps
COPY dialing ./dialing
COPY deploy/gunicorn.conf.py deploy/container_health.py ./deploy/

# Immutable, compressed static assets are included in every release image and
# served by WhiteNoise. The migration container repeats collection as validation.
# This throwaway key never becomes a runtime environment variable or secret.
RUN DJANGO_SECRET_KEY=collectstatic-only DJANGO_DEBUG=false \
    DJANGO_ALLOWED_HOSTS=localhost DATABASE_URL=sqlite://:memory: \
    .venv/bin/python manage.py collectstatic --noinput

FROM python:${PYTHON_VERSION}-slim-trixie
ARG APP_PROJECT=voice-agent
LABEL io.vaani.application="voice-agent" io.vaani.component="backend" io.vaani.project="${APP_PROJECT}"
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH="/app/.venv/bin:$PATH"
ARG UID=10001
RUN adduser --disabled-password --gecos "" --home /app --shell /sbin/nologin \
    --uid "${UID}" appuser
# Refresh Debian security fixes, then remove unused mount/account-management
# tools after creating the runtime user. Apt retains Essential/protected packages
# and all required native libraries; keep dpkg metadata for vulnerability scans.
# Immutable runtimes never install dependencies. Remove pip and its ensurepip
# bootstrap archive as functionality, not just scanner metadata; the build stage
# retains its installers and the locked application environment is unchanged.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get purge -y --auto-remove mount passwd \
    && apt-get check \
    && python -m pip uninstall -y pip \
    && python -c "import ensurepip, pathlib, shutil, sysconfig; bootstrap = pathlib.Path(ensurepip.__file__).resolve().parent; stdlib = pathlib.Path(sysconfig.get_path('stdlib')).resolve(); assert bootstrap == stdlib / 'ensurepip' and bootstrap.is_dir(); shutil.rmtree(bootstrap)" \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=appuser:appuser /app /app
RUN mkdir -p /app/private_recordings /app/staticfiles-public \
    && chown appuser:appuser /app/private_recordings /app/staticfiles-public \
    && chmod 700 /app/private_recordings
WORKDIR /app
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["python", "/app/deploy/container_health.py"]
CMD ["gunicorn", "--config", "/app/deploy/gunicorn.conf.py", "config.wsgi:application"]
