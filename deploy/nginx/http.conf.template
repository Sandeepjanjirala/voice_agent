# Managed by Vaani: @@PROJECT@@. Only this server block belongs to Voice Agent.
server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN@@;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/@@PROJECT@@/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://@@DOMAIN@@$request_uri; }
}
