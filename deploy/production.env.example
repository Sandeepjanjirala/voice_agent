# Production settings for deploy/compose.yaml. Copy to deploy/.env.production
# (git-ignored), fill in, and keep it out of backups that leave the server.
# Every name is explained in ../.env.example.

# --- Server and HTTPS -------------------------------------------------------------
SITE_DOMAIN=calls.example.org
ACME_EMAIL=admin@example.org
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=calls.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://calls.example.org
DJANGO_HSTS_SECONDS=3600
DJANGO_SESSION_HOURS=12
DJANGO_LOG_LEVEL=INFO

# --- Data stores (letters and digits only: they go inside URLs) --------------------
# python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Keys for stored phone numbers (docs/CONTACT_KEYS.md) ---------------------------
# Back these up separately from database backups. Losing them loses every number.
CONTACT_ENCRYPTION_KEYS=
CONTACT_LOOKUP_KEY=

# --- LiveKit, LLM and voice ---------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=telugu-agent
LLM_PROVIDER=livekit
LLM_MODEL=google/gemma-4-31b-it
SARVAM_API_KEY=

# --- Worker callbacks (the worker on LiveKit Cloud posts here) ---------------------
CALL_EVENTS_URL=https://calls.example.org/api/telephony/call-events/
CALL_EVENTS_SECRET=

# --- Switches that stay off until the owner authorises them -------------------------
INTEGRATIONS_LIVE_ENABLED=false
OUTBOUND_TEST_ALLOWED_NUMBER=
TELEPHONY_CONFIRMED=
