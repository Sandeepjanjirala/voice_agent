# Shared VPS backend; deploy.sh generates missing secrets ONCE in a new 0600 file.
# Preserve original keys before importing existing encrypted data. Never commit secrets.
SITE_DOMAIN=voice.sandeepwebsolutions.in
APP_PORT=8003
COMPOSE_PROJECT_NAME=voice-agent
ACME_EMAIL=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=voice.sandeepwebsolutions.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://voice.sandeepwebsolutions.in
DJANGO_BEHIND_PROXY=true
DJANGO_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
DEV_AUTO_LOGIN_USER=
INTEGRATIONS_ALLOW_LOCAL=false
CELERY_TASK_ALWAYS_EAGER=false
DJANGO_HSTS_SECONDS=3600
DJANGO_SESSION_HOURS=12
DJANGO_LOG_LEVEL=INFO

# --- Data stores (generated automatically; never regenerate on updates) ----------
# Passwords must use URL-safe letters, digits, underscores and hyphens.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_DB=vaani
POSTGRES_USER=vaani

# --- Keys for stored phone numbers (docs/CONTACT_KEYS.md) ---------------------------
# Back these up separately from database backups. Losing them loses every number.
CONTACT_ENCRYPTION_KEYS=
CONTACT_LOOKUP_KEY=
RECORDING_ENCRYPTION_KEYS=
RECORDING_STORAGE=local
RECORDING_LOCAL_DIR=/app/private_recordings
# Recording remains OFF in new organisations. Retention: Settings > Data retention.
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=90
CELERY_CONCURRENCY=1
# Resource caps are conservative starting limits, not measured capacity guarantees.
POSTGRES_MEMORY_LIMIT=384m
POSTGRES_CPUS=0.50
REDIS_MEMORY_LIMIT=160m
REDIS_CPUS=0.15
REDIS_MAXMEMORY=96mb
MIGRATE_MEMORY_LIMIT=512m
MIGRATE_CPUS=0.75
WEB_MEMORY_LIMIT=512m
WEB_CPUS=0.75
WORKER_MEMORY_LIMIT=512m
WORKER_CPUS=0.50
BEAT_MEMORY_LIMIT=192m
BEAT_CPUS=0.15
BACKUP_KEEP_DAYS=14
BACKUP_DIR=backups
DEPLOY_MIN_AVAILABLE_MB=1200
DEPLOY_MIN_FREE_GB=6
DEPLOY_MIN_BUILD_GB=3
DEPLOY_MAX_SWAP_PERCENT=80
DEPLOY_PUBLIC_HTTPS=false

# --- LiveKit, LLM and voice ---------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=telugu-agent
LLM_PROVIDER=livekit
LLM_MODEL=google/gemma-4-31b-it
SARVAM_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=
LIVEKIT_INFERENCE_URL=
EMPLOYEE_DRAFT_MODEL=
GEMINI_API_KEY=
GEMINI_ASSISTANT_MODEL=gemini-3.1-flash-lite

# --- Worker callbacks (the worker on LiveKit Cloud posts here) ---------------------
CALL_EVENTS_URL=https://voice.sandeepwebsolutions.in/api/telephony/call-events/
CALL_PROFILE_URL=https://voice.sandeepwebsolutions.in/api/telephony/call-profile/
CALL_RECORDING_URL=https://voice.sandeepwebsolutions.in/api/telephony/call-recording/
INBOUND_CONTEXT_URL=https://voice.sandeepwebsolutions.in/api/telephony/inbound-context/
CALL_EVENTS_SECRET=
# Calls carry a signed reference; the worker fetches the instructions from Django.
CALL_PROFILE_BY_REFERENCE=true
# Instruction size per employee (Django) and the worker's limit (>= that + 2048).
EMPLOYEE_INSTRUCTION_BYTES=6144
AGENT_PROFILE_BUDGET_BYTES=8192

# --- Switches that stay off until the owner authorises them -------------------------
OUTBOUND_DIALING_MODE=allowlist
OUTBOUND_ALLOWLIST_NUMBERS=
CONTACT_DIALING_ENABLED=false
TELEPHONY_CONFIRMED=
TELEPHONY_PROVIDER=vobiz
OUTBOUND_TEST_ALLOWED_NUMBER=
SIP_OUTBOUND_ADDRESS=
SIP_OUTBOUND_AUTH_USERNAME=
SIP_OUTBOUND_AUTH_PASSWORD=
SIP_OUTBOUND_CALLER_ID=
SIP_OUTBOUND_TRANSPORT=tls
SIP_OUTBOUND_MEDIA_ENCRYPTION=require
SIP_OUTBOUND_DESTINATION_COUNTRY=in
SIP_OUTBOUND_RINGING_TIMEOUT_SECONDS=30
SIP_OUTBOUND_MAX_CALL_DURATION_SECONDS=300
# Incoming calls are deferred. Do not add provider confirmations just to pass checks.
SIP_INBOUND_NUMBERS=
SIP_INBOUND_AUTH_MODE=ip_allowlist
SIP_INBOUND_AUTH_USERNAME=
SIP_INBOUND_AUTH_PASSWORD=
SIP_INBOUND_ALLOWED_ADDRESSES=
SIP_INBOUND_TRANSPORT=tls
SIP_MEDIA_ENCRYPTION=require
SIP_MAX_CALL_DURATION_SECONDS=600
