# Copy to .env.local and fill in. .env.local is git-ignored; never commit secrets.
# Both processes read this file: the voice worker (voice_agent/) and Django (config/).
# Blank values fall back to the defaults shown in the comments.

# --- LiveKit Cloud -----------------------------------------------------------
# `lk cloud auth` then `lk app env --write --destination .env.local` fills these in.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Sarvam AI (Telugu STT + TTS) ---------------------------------------------
SARVAM_API_KEY=

# --- Voice worker --------------------------------------------------------------
# Name the worker registers under; dispatch rules must match it (Phase 2).
AGENT_NAME=telugu-agent
# Spoken in the prompt as the business the assistant answers for.
BUSINESS_NAME=
# First thing the agent says. Default is a Telugu greeting that says it is an AI.
AGENT_GREETING=
# Spoken when the STT or LLM fails. Default is a Telugu apology.
AGENT_FALLBACK_MESSAGE=
# Background noise removal on the microphone/phone audio. LiveKit Cloud only:
# set false if you self-host LiveKit.
NOISE_CANCELLATION=true
# true gives the agent an end_call tool: it says one goodbye and hangs up when the
# caller is clearly finished. Off by default; with it off the agent cannot hang up.
AGENT_CAN_END_CALL=false

# --- Speech-to-text -------------------------------------------------------------
# standard = saaras:v4 streaming, reconnects by itself (default).
# realtime = saaras:v3-realtime: needs a Sarvam plan with realtime access, is
#            billed per connection and does not reconnect after a drop.
SARVAM_STT_MODE=standard
# saaras:v4 | saaras:v3 (standard mode only)
SARVAM_STT_MODEL=saaras:v4
# codemix keeps English words in Latin letters inside Telugu text (default).
# Others: transcribe | verbatim | translit | translate
SARVAM_STT_TASK=codemix
# te-IN, en-IN, hi-IN ... or auto to detect the language per utterance.
SARVAM_STT_LANGUAGE=te-IN
# 16000 for microphone tests; 8000 for narrowband telephony (Phase 2).
SARVAM_STT_SAMPLE_RATE=16000
# Optional hint: names, places and terms the recogniser should expect.
SARVAM_STT_PROMPT=
# true makes Sarvam's voice detection pick up soft or very short replies.
SARVAM_STT_HIGH_VAD_SENSITIVITY=
# realtime mode: fall over to the standard API if the realtime socket drops.
SARVAM_STT_REALTIME_FALLBACK=true
# realtime mode: silence (ms) Sarvam waits before ending the caller's turn.
SARVAM_STT_VAD_MIN_SILENCE_MS=

# --- Text-to-speech ---------------------------------------------------------------
# Owner-approved model. Also supported: bulbul:v3 (code fallback), bulbul:v2.
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_LANGUAGE=te-IN
# v4 Flash uses persona IDs, e.g. shubh_enhi_ads (not the v3 name shubh).
# Must belong to the chosen model. bulbul:v3 female: kavitha, kavya, pooja, priya,
# shreya, simran ...; male: shubh, aditya, rahul, rohan ... A wrong name is
# rejected at startup with the full list.
SARVAM_TTS_SPEAKER=shubh_enhi_ads
# v4 Flash: 0.5 - 2.0. Owner-approved Playground pace: 1.0.
# Published employees with an explicit pace keep their own setting.
SARVAM_TTS_PACE=1.0
# 0.01 - 2.0
SARVAM_TTS_TEMPERATURE=0.6
# 24000 matches the approved browser sample; telephony may resample.
SARVAM_TTS_SAMPLE_RATE=24000
# Characters buffered before speech starts (30 - 200). Lower = faster first audio.
SARVAM_TTS_MIN_BUFFER_SIZE=50
# Longest chunk sent to the voice at once (50 - 500).
SARVAM_TTS_MAX_CHUNK_LENGTH=150
# Optional Sarvam pronunciation dictionary id for brand and domain words.
SARVAM_TTS_DICT_ID=

# --- LLM ---------------------------------------------------------------------------
# livekit           = LiveKit Inference, billed to the LiveKit project, no extra key (default)
# openai            = OpenAI directly, needs OPENAI_API_KEY
# openai_compatible = any OpenAI-compatible endpoint, needs LLM_BASE_URL + LLM_API_KEY + LLM_MODEL
LLM_PROVIDER=livekit
# Default: google/gemma-4-31b-it (livekit) or gpt-4.1-mini (openai). LiveKit retires
# models on a schedule; see https://docs.livekit.io/agents/models/llm/
LLM_MODEL=
LLM_TEMPERATURE=0.3
# Reply length cap. Telugu script uses several tokens per word, so do not set this very low.
LLM_MAX_TOKENS=250
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
# --- Stored contacts ---------------------------------------------------------------
# Phone numbers of contacts are encrypted before they reach the database.
# Create both values with:  python manage.py contactkeys generate
# Keep them out of Git and out of database backups; losing them loses the numbers.
# Comma-separated Fernet keys, newest first. To rotate: add a new key in front,
# run `python manage.py contactkeys rotate`, then remove the old key.
CONTACT_ENCRYPTION_KEYS=
# Key for matching numbers (duplicates, do-not-call) without decrypting them.
# At least 32 characters. Changing it needs `python manage.py contactkeys rehash`.
CONTACT_LOOKUP_KEY=

# --- Call recordings (docs/RECORDINGS.md) --------------------------------------------
# Off for every organisation until an admin chooses it under Privacy & settings,
# and then only after the person agrees on the call.
# Keys that encrypt every recording before it is stored (Fernet, comma-separated;
# the first encrypts, all decrypt). Create one with:
#   python manage.py recordings key
# Keep it out of Git and out of backups of the recordings themselves.
RECORDING_ENCRYPTION_KEYS=
# local: a private folder on this server (development, one server).
# s3: a private S3-compatible bucket, for production (India: ap-south-1).
RECORDING_STORAGE=local
# Blank: private_recordings/ in the project (git-ignored). Never a public folder.
RECORDING_LOCAL_DIR=
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=ap-south-1
# Only for S3-compatible services other than AWS.
RECORDING_S3_ENDPOINT=
# An IAM user (or role) allowed only s3:PutObject, s3:GetObject and
# s3:DeleteObject on this bucket.
RECORDING_S3_ACCESS_KEY_ID=
RECORDING_S3_SECRET_ACCESS_KEY=
# Blank: S3-managed encryption. A KMS key ID or ARN: encryption with that key.
RECORDING_S3_KMS_KEY_ID=

# Optional: model used by the dashboard to draft AI employees. Defaults to LLM_MODEL.
EMPLOYEE_DRAFT_MODEL=
# Optional: override the LiveKit Inference gateway address.
LIVEKIT_INFERENCE_URL=

# --- Turn-taking and interruptions ---------------------------------------------
# vad     = end the caller's turn after a pause (default)
# stt     = trust Sarvam's own end-of-speech signal
# livekit = LiveKit turn-detector model; Telugu is NOT on its supported list
TURN_DETECTION=vad
# Seconds of silence before the agent replies. Raise if callers get cut off
# while thinking; lower for snappier replies.
TURN_ENDPOINTING_MIN_DELAY=0.35
TURN_ENDPOINTING_MAX_DELAY=3.0
# auto = adaptive barge-in on LiveKit Cloud, plain voice detection otherwise.
# adaptive | vad force one of them.
INTERRUPTION_MODE=auto
# Seconds of caller speech needed to interrupt the agent.
INTERRUPTION_MIN_DURATION=0.5
# Words the caller must say to interrupt the agent (0 - 5). 0 (default) lets a
# one-syllable "ఆ" or "ఊ" stop the agent and replace its answer. 2 ignores
# such acknowledgements but also ignores a one-word "ఆగండి".
INTERRUPTION_MIN_WORDS=0
# true: a lone acknowledgement ("ఆ", "ఊ", "హా", "okay") said while the agent is
# talking no longer discards its reply; the reply pauses and resumes. Any other
# word, including "ఆగండి", "stop" and "bye", still interrupts. Default false.
INTERRUPTION_IGNORE_ACKS=false
# Carry on speaking if an interruption turns out to be noise.
INTERRUPTION_RESUME_FALSE=true
# Seconds of silence after a suspected interruption before the agent resumes
# (0.5 - 5.0). This is also how long the caller hears it pause when the
# 'interruption' was only noise or echo. Default 2.0, the LiveKit default.
INTERRUPTION_FALSE_TIMEOUT=2.0
# Start the LLM while still confirming the caller has finished.
PREEMPTIVE_GENERATION=true
# Prepare speech audio before turn confirmation too. Playback still waits for
# the confirmed turn. May synthesize discarded audio (extra provider usage).
# Set false to compare latency/cost with LLM-only preemptive generation.
PREEMPTIVE_TTS=true

# --- Worker logging -----------------------------------------------------------------
# debug | info | warning | error
VOICE_LOG_LEVEL=info
# Logs what the caller and agent said. Useful while tuning; set false where
# transcripts are personal data.
VOICE_LOG_TRANSCRIPTS=true
# Per-turn latency rows (timings only, no text). "off" disables.
VOICE_METRICS_LOG=logs/turn_metrics.jsonl

# --- Django backend ------------------------------------------------------------------
# Generate: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# true only on your own machine.
DJANGO_DEBUG=true
# Comma-separated; required when DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=
# Leave blank. The test settings set it in the environment (not in this file) so
# that .env.local is never read by the tests or the browser QA servers.
SKIP_ENV_LOCAL=
# Local development only (needs DJANGO_DEBUG=true): a username, e.g. the one made
# with createsuperuser. Browsers on this computer open the dashboard already
# signed in as that user, with no login page. Requests from any other address,
# and every server with DJANGO_DEBUG=false, still need a password. Blank: off.
DEV_AUTO_LOGIN_USER=
# postgres://USER:PASSWORD@HOST:5432/DBNAME. Blank uses a local SQLite file,
# which is only acceptable until models arrive in Phase 4.
DATABASE_URL=
DJANGO_LOG_LEVEL=INFO
# HTTPS and cookies. Defaults follow DJANGO_DEBUG: with DEBUG off, plain HTTP is
# redirected to HTTPS and cookies are HTTPS-only. See docs/DEPLOYMENT.md.
DJANGO_SSL_REDIRECT=
DJANGO_SECURE_COOKIES=
# Full origins allowed to post forms, e.g. https://calls.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# true only behind a proxy that ends TLS and sets X-Forwarded-Proto (deploy/Caddyfile).
DJANGO_BEHIND_PROXY=false
# Strict-Transport-Security. Start at 3600; raise to 31536000 once HTTPS is proven.
DJANGO_HSTS_SECONDS=
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# How long a sign-in lasts.
DJANGO_SESSION_HOURS=12

# --- Background jobs (Celery + Redis) -----------------------------------------------
# redis://[:password@]host:6379/0. Broker for Celery and the shared cache. Blank:
# no queue, so jobs (call summaries, call lists) run inside Django instead.
REDIS_URL=
# Blank: true without REDIS_URL, false with it. true runs jobs inside the
# request that queues them; set false only with a running Celery worker.
CELERY_TASK_ALWAYS_EAGER=

# --- Outside requests ------------------------------------------------------------------
# Development only (needs DJANGO_DEBUG=true): allow http:// and local addresses for
# Django's outside requests. Leave false.
INTEGRATIONS_ALLOW_LOCAL=false

# --- Inbound telephony (Phase 2, planning only) ------------------------------------
# Read by Django: `manage.py telephony plan|status|apply|teardown`. Leave blank
# until a provider account and number exist; see docs/VOBIZ_SETUP.md.
# vobiz | plivo
TELEPHONY_PROVIDER=
# The purchased number in E.164 form: +91XXXXXXXXXX. Several may be listed,
# separated by commas. `manage.py telephony` also adds every number routed to an
# employee on the Numbers & channels page; all of them share one trunk.
TELEPHONY_INBOUND_NUMBER=
# LiveKit project ID without the p_ prefix (LiveKit Cloud > Settings > Project).
LIVEKIT_SIP_SUBDOMAIN=
# india (default for Indian providers) | global | aus | canada | eu | japan | sa | us
LIVEKIT_SIP_REGION=
# tls only. tcp is accepted as a value but blocks the plan (unencrypted signalling).
SIP_INBOUND_TRANSPORT=tls
# digest       = provider authenticates with the username and password below (default)
# ip_allowlist = LiveKit accepts calls only from SIP_INBOUND_ALLOWED_ADDRESSES;
#                LiveKit support must enable enforcement for the project first.
# Matching the dialled number alone is never accepted as authentication.
# Blank uses the provider's documented method: digest for plivo, ip_allowlist for vobiz.
SIP_INBOUND_AUTH_MODE=
SIP_INBOUND_AUTH_USERNAME=
# Secret, at least 12 characters. Never printed by any command.
SIP_INBOUND_AUTH_PASSWORD=
# Comma-separated provider signalling IPs or CIDR blocks (ip_allowlist mode).
SIP_INBOUND_ALLOWED_ADDRESSES=
# require (default) | allow (falls back to unencrypted audio) | off (blocks the plan)
SIP_MEDIA_ENCRYPTION=require
# Seconds a caller hears ringing if no worker answers (5 - 60).
SIP_RINGING_TIMEOUT_SECONDS=25
# Hard cap on one call, as a cost guard (60 - 3600).
SIP_MAX_CALL_DURATION_SECONDS=600
# true keeps the caller's number away from the worker and its logs.
SIP_HIDE_CALLER_NUMBER=true
# Rooms are named <prefix><our number>_<random>, one per call.
SIP_ROOM_PREFIX=call-
# Comma-separated facts you have confirmed in writing. Each missing one blocks
# the plan. Valid entries: provider_account_ready, livekit_regional_sip_endpoint,
# provider_inbound_digest_auth, livekit_allowed_addresses_enforced, provider_inbound_srtp,
# provider_outbound_ready, outbound_plain_signalling_accepted
TELEPHONY_CONFIRMED=

# --- Outbound test call (one number only) -------------------------------------------
# `manage.py telephony outbound-plan|outbound-apply|call`. See docs/OUTBOUND_TEST.md.
# SIP domain of the Vobiz outbound trunk, without "sip:" (for example xxxx.sip.vobiz.ai).
SIP_OUTBOUND_ADDRESS=
# The SIP credential attached to that trunk. The password is secret and never printed.
SIP_OUTBOUND_AUTH_USERNAME=
SIP_OUTBOUND_AUTH_PASSWORD=
# The Vobiz India number on your account, +91XXXXXXXXXX. The only caller ID presented.
SIP_OUTBOUND_CALLER_ID=
# tls (default). tcp or udp block the plan unless outbound_plain_signalling_accepted
# is listed in TELEPHONY_CONFIRMED.
SIP_OUTBOUND_TRANSPORT=tls
# require (default) | allow (audio is encrypted only if the provider accepts SRTP)
SIP_OUTBOUND_MEDIA_ENCRYPTION=require
# Must be "in": calls originate from LiveKit's India region so media stays in India.
SIP_OUTBOUND_DESTINATION_COUNTRY=in
# Seconds to let the phone ring (10 - 60) and the longest a test call may last (30 - 600).
SIP_OUTBOUND_RINGING_TIMEOUT_SECONDS=30
SIP_OUTBOUND_MAX_CALL_DURATION_SECONDS=300
# --- Who may be dialled (read by Django AND the voice worker; restart both) --------
# allowlist (default): only the numbers below. live: any valid number, still
# checked for permission to call, campus hours and 09:00-21:00. Do not use live
# until the provider and you have approved real outbound calling.
OUTBOUND_DIALING_MODE=allowlist
# Comma-separated E.164 numbers, e.g. +91XXXXXXXXXX,+91YYYYYYYYYY. The first one is
# where rehearsals ring. Blank: OUTBOUND_TEST_ALLOWED_NUMBER below is used instead.
OUTBOUND_ALLOWLIST_NUMBERS=
# Deprecated single test number, kept so existing installations keep working.
OUTBOUND_TEST_ALLOWED_NUMBER=
# Calling a stored contact (a lead's "Call" button, campaign dispatch). Off: only
# the numbers typed on the Phone calls page and rehearsals can be dialled.
CONTACT_DIALING_ENABLED=false

# --- Call records: worker -> Django outcome reports ----------------------------------
# The worker posts each outbound call's outcome, SIP status and latency summary to
# Django, signed with this shared secret. No phone numbers or transcripts are sent.
# Blank turns reporting off; Django then infers outcomes from LiveKit room state.
# Local runserver: http://127.0.0.1:8000/api/telephony/call-events/
CALL_EVENTS_URL=
# At least 32 random characters, the same value for Django and the worker. Generate:
# .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
CALL_EVENTS_SECRET=
# Optional. Where the voice worker asks Django which published AI employee answers
# an inbound phone call, e.g. http://127.0.0.1:8000/api/telephony/inbound-context/
# Signed with CALL_EVENTS_SECRET. Unset keeps inbound calls on the job's own profile.
# Setting this does not open any phone line: inbound SIP stays off until the trunk
# is authenticated (see docs/INBOUND.md).
INBOUND_CONTEXT_URL=
# Said once, then the call ends, when a phone call reaches the worker but Django
# assigns no published employee (unknown number, paused employee, Django down).
# Keep it neutral: no organisation name, no promises. Blank uses the built-in line.
INBOUND_UNROUTED_MESSAGE=
# Local testing only: path to a JSON file holding an employee profile, in the
# shape Django sends ({"agent_profile": {...}}). `lk agent console` and
# `lk agent debugger` sessions then talk as that employee. Never used for a
# dispatched call or a phone call. Blank: the plain agent.
CONSOLE_PROFILE_FILE=
# Where the worker fetches a phone call's employee profile by signed reference.
# Blank: next to CALL_EVENTS_URL (.../api/telephony/call-profile/).
CALL_PROFILE_URL=
# Where the worker uploads a recorded call's audio, signed with CALL_EVENTS_SECRET.
# Blank: next to CALL_EVENTS_URL (/api/telephony/call-recording/).
CALL_RECORDING_URL=
# Django: send phone calls a signed reference instead of the instructions, so
# LiveKit job metadata holds no instructions or caller details. Blank: on when
# CALL_EVENTS_URL is set. The worker refuses to dial if it cannot fetch them.
CALL_PROFILE_BY_REFERENCE=

# --- AI employee instruction size ------------------------------------------------------
# Django: bytes an employee's name, purpose, steps, details, limits and ending may
# take together (UTF-8; a Telugu letter takes three). 6144 is about 2000 Telugu
# letters. They reach the LLM on every turn, so keep it bounded (800 - 16384).
EMPLOYEE_INSTRUCTION_BYTES=6144
# Worker: bytes for the whole per-call prompt section (instructions plus labels,
# caller context and notices). At least EMPLOYEE_INSTRUCTION_BYTES + 2048.
AGENT_PROFILE_BUDGET_BYTES=8192

# --- Local PostgreSQL (docker compose --env-file .env.local up -d) -----------------
# Used only by compose.yaml. Then set DATABASE_URL to
# postgres://telugu_agent:<this password>@127.0.0.1:5432/telugu_agent
POSTGRES_PASSWORD=
